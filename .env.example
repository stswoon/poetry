# Скопируй этот файл в .env в корне проекта и заполни значения.
# .env в git не попадает (см. .gitignore).

# OAuth-токен Яндекс Диска, доступ ко всему Диску
# https://oauth.yandex.ru/client/new → cloud_api:disk.read, write, info
YANDEX_DISK_TOKEN=

# API-ключ ElevenLabs
# https://elevenlabs.io/app/developers/api-keys
ELEVENLABS_API_KEY=
