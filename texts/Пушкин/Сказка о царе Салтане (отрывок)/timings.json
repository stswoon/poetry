{
  "voiceDuration": 48.64,
  "introDuration": 4,
  "outroDuration": 6,
  "lines": [
    {
      "index": 1,
      "text": "Ветер на море гуляет",
      "start": 0.02,
      "end": 1.785
    },
    {
      "index": 2,
      "text": "И кораблик подгоняет;",
      "start": 2.058,
      "end": 3.483
    },
    {
      "index": 3,
      "text": "Он бежит себе в волнах",
      "start": 3.797,
      "end": 5.55
    },
    {
      "index": 4,
      "text": "На раздутых парусах.",
      "start": 5.676,
      "end": 7.187
    },
    {
      "index": 5,
      "text": "Корабельщики дивятся,",
      "start": 7.626,
      "end": 9.05
    },
    {
      "index": 6,
      "text": "На кораблике толпятся,",
      "start": 9.151,
      "end": 10.788
    },
    {
      "index": 7,
      "text": "На знакомом острову",
      "start": 11.059,
      "end": 12.358
    },
    {
      "index": 8,
      "text": "Чудо видят наяву:",
      "start": 12.627,
      "end": 14.126
    },
    {
      "index": 9,
      "text": "Город новый златоглавый,",
      "start": 14.421,
      "end": 16.32
    },
    {
      "index": 10,
      "text": "Пристань с крепкою заставой —",
      "start": 16.609,
      "end": 18.456
    },
    {
      "index": 11,
      "text": "Пушки с пристани палят,",
      "start": 18.802,
      "end": 20.229
    },
    {
      "index": 12,
      "text": "Кораблю пристать велят.",
      "start": 20.5,
      "end": 22.027
    },
    {
      "index": 13,
      "text": "Пристают к заставе гости;",
      "start": 22.422,
      "end": 24.051
    },
    {
      "index": 14,
      "text": "Князь Гвидон зовёт их в гости,",
      "start": 24.537,
      "end": 26.537
    },
    {
      "index": 15,
      "text": "Их он кормит и поит",
      "start": 26.775,
      "end": 28.377
    },
    {
      "index": 16,
      "text": "И ответ держать велит:",
      "start": 28.674,
      "end": 29.96
    },
    {
      "index": 17,
      "text": "«Чем вы, гости, торг ведёте",
      "start": 30.352,
      "end": 32.192
    },
    {
      "index": 18,
      "text": "И куда теперь плывёте?»",
      "start": 32.502,
      "end": 33.78
    },
    {
      "index": 19,
      "text": "Корабельщики в ответ:",
      "start": 34.201,
      "end": 35.466
    },
    {
      "index": 20,
      "text": "«Мы объехали весь свет,",
      "start": 35.848,
      "end": 37.705
    },
    {
      "index": 21,
      "text": "Торговали соболями,",
      "start": 37.94,
      "end": 39.27
    },
    {
      "index": 22,
      "text": "Чернобурыми лисами;",
      "start": 39.344,
      "end": 40.616
    },
    {
      "index": 23,
      "text": "А теперь нам вышел срок,",
      "start": 41.008,
      "end": 42.693
    },
    {
      "index": 24,
      "text": "Едем прямо на восток,",
      "start": 42.881,
      "end": 44.548
    },
    {
      "index": 25,
      "text": "Мимо острова Буяна,",
      "start": 44.649,
      "end": 46.145
    },
    {
      "index": 26,
      "text": "В царство славного Салтана…»",
      "start": 46.372,
      "end": 48.469
    }
  ]
}
